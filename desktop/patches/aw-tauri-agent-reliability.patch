+        let directory =
+            std::env::temp_dir().join(format!("claritide-bindings-{}", super::new_uuid_v4()));
+        std::fs::create_dir_all(&directory).unwrap();
+        let original = directory.join("project-a");
+        let other = directory.join("project-b");
+        let id = super::new_uuid_v4();
+        assert!(super::validate_session_binding(&directory, &id, &original, false).is_ok());
+        // Updating the same registry must preserve earlier bindings, including
+        // on Windows where the destination file already exists.
+        assert!(
+            super::validate_session_binding(&directory, &super::new_uuid_v4(), &other, false)
+                .is_ok()
+        );
+        assert!(super::validate_session_binding(&directory, &id, &original, true).is_ok());
+        assert!(super::validate_session_binding(&directory, &id, &other, true).is_err());
+        assert!(super::validate_session_binding(
+            &directory,
+            &super::new_uuid_v4(),
+            &original,
+            true
+        )
+        .is_err());
+        assert!(super::validate_session_binding(&directory, &id, &original, false).is_err());
+        std::fs::remove_dir_all(&directory).unwrap();
+    }
