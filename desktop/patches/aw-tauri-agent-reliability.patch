+fn write_approval_response(
+    session: &mut SessionRecord,
+    request_id: &str,
+    approval: &PendingApproval,
+    allow: bool,
+) -> Result<(), String> {
+    write_control(session, approval_response(request_id, approval, allow))
+}
+
+fn approval_response(request_id: &str, approval: &PendingApproval, allow: bool) -> Value {
+    let response = if allow {
+        json!({ "behavior": "allow", "updatedInput": approval.input, "toolUseID": approval.tool_use_id })
+    } else {
+        json!({ "behavior": "deny", "message": "The user declined this operation", "interrupt": false,
+            "toolUseID": approval.tool_use_id })
+    };
+    json!({
+        "type": "control_response",
+        "response": { "subtype": "success", "request_id": request_id, "response": response }
+    })
+}
+
+fn validate_session_binding(
+    config_dir: &Path,
+    session_id: &str,
+    workspace: &Path,
+    resume: bool,
+) -> Result<(), String> {
+    let path = config_dir.join("claritide-session-workspaces.json");
+    let mut bindings: HashMap<String, PathBuf> = if path.exists() {
+        serde_json::from_slice(
+            &std::fs::read(&path).map_err(|_| "Unable to read saved conversation bindings")?,
+        )
+        .map_err(|_| "Saved conversation bindings are invalid")?
+    } else {
+        HashMap::new()
+    };
+    if resume {
+        if bindings.get(session_id).map(PathBuf::as_path) != Some(workspace) {
+            return Err("The saved conversation belongs to another folder; choose its original project folder".to_string());
+        }
+        return Ok(());
+    }
+    if bindings.contains_key(session_id) {
+        return Err("This conversation already exists; resume it instead".to_string());
+    }
+    bindings.insert(session_id.to_string(), workspace.to_path_buf());
+    let temporary = config_dir.join("claritide-session-workspaces.tmp");
+    let data =
+        serde_json::to_vec(&bindings).map_err(|_| "Unable to encode conversation bindings")?;
+    std::fs::write(&temporary, data).map_err(|_| "Unable to save conversation bindings")?;
+    std::fs::rename(&temporary, &path).map_err(|_| "Unable to commit conversation bindings")?;
+    Ok(())
+}
