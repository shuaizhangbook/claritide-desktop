+    fn approval_replies_preserve_original_input_and_do_not_grant_prefixes() {
+        let approval = super::PendingApproval {
+            tool_use_id: "tool-123".to_string(),
+            tool_name: "Bash".to_string(),
+            input: serde_json::json!({ "command": "git status" }),
+        };
+        let response = super::approval_response("request-123", &approval, true);
+        assert_eq!(response["response"]["response"]["behavior"], "allow");
+        assert_eq!(
+            response["response"]["response"]["updatedInput"],
+            approval.input
+        );
+        assert_eq!(response["response"]["response"]["toolUseID"], "tool-123");
+        let mut changed = approval.clone();
+        changed.input = serde_json::json!({ "command": "git status; echo different" });
+        assert_ne!(approval.operation_key(), changed.operation_key());
+        changed.input = serde_json::json!({ "command": "git status", "cwd": "/another-project" });
+        assert_ne!(approval.operation_key(), changed.operation_key());
+        let denied = super::approval_response("request-123", &approval, false);
+        assert_eq!(denied["response"]["response"]["behavior"], "deny");
+        assert!(denied["response"]["response"].get("updatedInput").is_none());
+    }
