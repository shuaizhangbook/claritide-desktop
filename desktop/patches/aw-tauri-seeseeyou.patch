+        read_bounded_lines(&b"12345\nok"[..], 4, |line| output.push(line));
+        assert_eq!(output, vec![BoundedLine::Oversized]);
+    }
+
+    #[test]
+    fn result_text_is_only_a_fallback_without_a_canonical_assistant() {
