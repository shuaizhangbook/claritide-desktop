diff --git a/src-tauri/assets/agent-workbench.html b/src-tauri/assets/agent-workbench.html
new file mode 100644
index 0000000..d41cf66
--- /dev/null
+++ b/src-tauri/assets/agent-workbench.html
@@ -0,0 +1,207 @@
+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; connect-src ipc: http://ipc.localhost https://ipc.localhost;">
+  <title>Claritide AI Workbench</title>
+  <style>
+    :root { color-scheme: light dark; font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
+    * { box-sizing: border-box; }
+    body { margin: 0; background: #0b1020; color: #e8edf8; }
+    main { width: min(980px, calc(100% - 32px)); margin: 24px auto; display: grid; gap: 16px; }
+    header, section { border: 1px solid #26324d; border-radius: 14px; background: #11182a; padding: 16px; }
+    header { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
+    h1 { font-size: 20px; margin: 0 0 4px; }
+    p { color: #9eabc4; margin: 0; font-size: 13px; }
+    .status { border-radius: 999px; padding: 6px 10px; background: #26324d; font-size: 12px; }
+    .row { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
+    button, select, textarea { border: 1px solid #344365; border-radius: 9px; background: #172139; color: inherit; padding: 9px 11px; }
+    button { cursor: pointer; }
+    button.primary { background: #4569e8; border-color: #4569e8; }
+    button:disabled { cursor: not-allowed; opacity: .5; }
+    textarea { width: 100%; min-height: 100px; resize: vertical; margin: 12px 0; }
+    #workspace { color: #b8c4db; font-size: 13px; overflow-wrap: anywhere; }
+    #answer { min-height: 120px; white-space: pre-wrap; line-height: 1.55; }
+    #events { max-height: 220px; overflow: auto; margin: 0; padding-left: 20px; color: #9eabc4; font: 12px/1.5 ui-monospace, monospace; }
+    .error { color: #ff9b9b; }
+  </style>
+</head>
+<body>
+  <main>
+    <header>
+      <div><h1>Claritide AI Workbench</h1><p>Local agent runtime proof of concept</p></div>
+      <span class="status" id="status">Checking runtime…</span>
+    </header>
+    <section>
+      <div class="row">
+        <button id="choose">Choose workspace</button>
+        <select id="model" aria-label="Model"></select>
+      </div>
+      <div id="workspace">No workspace selected.</div>
+      <textarea id="prompt" placeholder="Describe the task…"></textarea>
+      <div class="row">
+        <button class="primary" id="send" disabled>Start and send</button>
+        <button id="stop" disabled>Stop turn</button>
+        <button id="close" disabled>Close session</button>
+      </div>
+    </section>
+    <section><div id="answer">Agent output will appear here.</div></section>
+    <section><ol id="events"></ol></section>
+  </main>
+  <script>
+    (function () {
+      'use strict';
+      var bridge = window.__CLARITIDE_CCB__;
+      var statusNode = document.getElementById('status');
+      var workspaceNode = document.getElementById('workspace');
+      var modelNode = document.getElementById('model');
+      var promptNode = document.getElementById('prompt');
+      var answerNode = document.getElementById('answer');
+      var eventsNode = document.getElementById('events');
+      var chooseButton = document.getElementById('choose');
+      var sendButton = document.getElementById('send');
+      var stopButton = document.getElementById('stop');
+      var closeButton = document.getElementById('close');
+      var workspace = null;
+      var sessionId = '';
+      var provisionalText = '';
+      var runtimeAvailable = false;
+      var turnActive = false;
+      var stopPending = false;
+      var MAX_RENDER_TEXT_CHARS = 256 * 1024;
+      var MAX_RENDER_EVENTS = 200;
+
+      if (!bridge) {
+        statusNode.textContent = 'Native bridge unavailable';
+        statusNode.className = 'status error';
+        Array.prototype.forEach.call(document.querySelectorAll('button, select, textarea'), function (control) {
+          control.disabled = true;
+        });
+        return;
+      }
+
+      function addEvent(event) {
+        var item = document.createElement('li');
+        item.textContent = event.type + (event.payload && event.payload.message ? ': ' + event.payload.message : '');
+        if (event.type === 'error') item.className = 'error';
+        eventsNode.appendChild(item);
+        while (eventsNode.childNodes.length > MAX_RENDER_EVENTS) {
+          eventsNode.removeChild(eventsNode.firstChild);
+        }
+        eventsNode.scrollTop = eventsNode.scrollHeight;
+      }
+
+      function boundedText(value) {
+        var text = String(value || '');
+        if (text.length <= MAX_RENDER_TEXT_CHARS) return text;
+        return '[Earlier output omitted]\n' + text.slice(-(MAX_RENDER_TEXT_CHARS - 25));
+      }
+
+      function setTurnState(active, stopping) {
+        turnActive = Boolean(active);
+        stopPending = turnActive && Boolean(stopping);
+        stopButton.disabled = !turnActive || stopPending;
+        closeButton.disabled = !sessionId;
+        chooseButton.disabled = Boolean(sessionId);
+        modelNode.disabled = Boolean(sessionId);
+        sendButton.disabled = !runtimeAvailable || !workspace || turnActive;
+        sendButton.textContent = sessionId ? 'Send' : 'Start and send';
+      }
+
+      async function refreshStatus() {
+        try {
+          var status = await bridge.getStatus();
+          statusNode.textContent = status.available
+            ? 'CCB ready · tools ' + status.toolsMode
+            : 'Runtime not configured';
+          statusNode.title = status.lastError || '';
+          runtimeAvailable = Boolean(status.available);
+          modelNode.textContent = '';
+          (status.allowedModels || ['default']).forEach(function (model) {
+            var option = document.createElement('option');
+            option.value = model;
+            option.textContent = model;
+            modelNode.appendChild(option);
+          });
+          setTurnState(turnActive, stopPending);
+        } catch (error) {
+          runtimeAvailable = false;
+          statusNode.textContent = 'Bridge unavailable';
+          statusNode.title = String(error);
+          setTurnState(turnActive, stopPending);
+        }
+      }
+
+      bridge.onEvent(function (event) {
+        addEvent(event);
+        if (sessionId && event.sessionId && event.sessionId !== sessionId) return;
+        if (event.type === 'text_delta') {
+          if (answerNode.textContent === 'Agent output will appear here.') answerNode.textContent = '';
+          provisionalText = boundedText(provisionalText + (event.payload.text || ''));
+          answerNode.textContent = provisionalText;
+        } else if (event.type === 'assistant_final') {
+          provisionalText = boundedText(event.payload.text || provisionalText);
+          answerNode.textContent = provisionalText;
+        } else if (event.type === 'turn_completed') {
+          setTurnState(false, false);
+        } else if (event.type === 'stopped') {
+          setTurnState(Boolean(event.payload && event.payload.settling), true);
+        } else if (event.type === 'error' && event.payload && event.payload.terminal === true) {
+          setTurnState(false, false);
+        }
+      });
+
+      document.getElementById('choose').addEventListener('click', async function () {
+        workspace = await bridge.selectWorkspace();
+        workspaceNode.textContent = workspace ? workspace.path : 'No workspace selected.';
+        setTurnState(turnActive, stopPending);
+      });
+
+      sendButton.addEventListener('click', async function () {
+        var content = promptNode.value.trim();
+        if (!workspace || !content || turnActive) return;
+        var startingSession = !sessionId;
+        if (startingSession) sessionId = crypto.randomUUID();
+        setTurnState(true, false);
+        try {
+          if (startingSession) {
+            await bridge.startSession({
+              clientSessionId: sessionId,
+              workspace: workspace.id,
+              model: modelNode.value || 'default',
+              locale: document.documentElement.lang || 'en'
+            });
+          }
+          provisionalText = '';
+          await bridge.send({ sessionId: sessionId, content: content });
+          promptNode.value = '';
+          setTurnState(true, false);
+        } catch (error) {
+          if (startingSession) sessionId = '';
+          addEvent({ type: 'error', payload: { message: String(error) } });
+          setTurnState(false, false);
+        }
+      });
+
+      stopButton.addEventListener('click', async function () {
+        if (!sessionId || !turnActive || stopPending) return;
+        setTurnState(true, true);
+        try {
+          await bridge.stop({ sessionId: sessionId });
+        } catch (error) {
+          addEvent({ type: 'error', payload: { message: String(error) } });
+          setTurnState(true, false);
+        }
+      });
+      closeButton.addEventListener('click', async function () {
+        if (!sessionId) return;
+        await bridge.close({ sessionId: sessionId });
+        sessionId = '';
+        setTurnState(false, false);
+      });
+      void refreshStatus();
+    })();
+  </script>
+</body>
+</html>
diff --git a/src-tauri/build.rs b/src-tauri/build.rs
index 047d942..c430367 100644
--- a/src-tauri/build.rs
+++ b/src-tauri/build.rs
@@ -0,0 +1,25 @@
+const APP_COMMANDS: &[&str] = &[
+    "greet",
+    "open_external",
+    "restart_app",
+    "close_update_progress",
+    "get_autostart_enabled",
+    "set_autostart_enabled",
+    "get_sync_status",
+    "get_or_create_installation_id",
+    "rotate_installation_id",
+    "configure_sync",
+    "pause_sync",
+    "resume_sync",
+    "trigger_sync_now",
+    "clear_sync",
+    "open_agent_workbench",
+    "agent_get_status",
+    "agent_select_workspace",
+    "agent_start",
+    "agent_send",
+    "agent_interrupt",
+    "agent_close",
+    "agent_poll_events",
+];
+
@@ -11 +36,10 @@ fn main() {
-    tauri_build::build();
+    // App commands that are not declared in the build manifest are allowed by
+    // Tauri for every window by default. Declare the complete invoke surface so
+    // the capability files become a mandatory, per-window ACL. In particular,
+    // the remote Claritide dashboard must never inherit the local agent runtime
+    // commands merely because they are registered by `generate_handler!`.
+    tauri_build::try_build(
+        tauri_build::Attributes::new()
+            .app_manifest(tauri_build::AppManifest::new().commands(APP_COMMANDS)),
+    )
+    .expect("failed to run tauri-build");
diff --git a/src-tauri/capabilities/agent-workbench.json b/src-tauri/capabilities/agent-workbench.json
new file mode 100644
index 0000000..045b843
--- /dev/null
+++ b/src-tauri/capabilities/agent-workbench.json
@@ -0,0 +1,19 @@
+{
+  "$schema": "../gen/schemas/desktop-schema.json",
+  "identifier": "agent-workbench",
+  "description": "Local-only Claritide agent workbench with a narrow runtime API",
+  "windows": [
+    "agent-workbench"
+  ],
+  "local": true,
+  "permissions": [
+    "core:default",
+    "allow-agent-get-status",
+    "allow-agent-select-workspace",
+    "allow-agent-start",
+    "allow-agent-send",
+    "allow-agent-interrupt",
+    "allow-agent-close",
+    "allow-agent-poll-events"
+  ]
+}
