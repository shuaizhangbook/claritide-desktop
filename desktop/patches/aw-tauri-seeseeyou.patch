+#[tauri::command]
+pub fn agent_get_status() -> AgentStatus {
+    let config = runtime_config();
+    let tools_mode = config
+        .as_ref()
+        .map(|config| config.tools_mode.as_str().to_string())
+        .unwrap_or_else(|_| {
+            ToolsMode::from_env()
+                .map(|mode| mode.as_str().to_string())
+                .unwrap_or_else(|_| "invalid".to_string())
+        });
+    let allowed_models = config
+        .as_ref()
+        .map(|config| config.models.clone())
+        .unwrap_or_else(|_| allowed_models().unwrap_or_default());
+    let (sessions, runtime_error) = lock_state()
+        .map(|state| {
+            let sessions = state
+                .sessions
+                .iter()
+                .map(|(session_id, session)| AgentSessionSummary {
+                    session_id: session_id.clone(),
+                    phase: session.phase.as_str().to_string(),
+                    workspace_id: session.workspace_id.clone(),
+                    workspace_name: session.workspace_name.clone(),
+                    model: session.model.clone(),
+                })
+                .collect();
+            (sessions, state.last_error.clone())
+        })
+        .unwrap_or_else(|error| (Vec::new(), Some(error)));
+    AgentStatus {
+        capability_version: CAPABILITY_VERSION,
+        available: config.is_ok(),
+        runtime: "ccb",
+        tools_mode,
+        allowed_models,
+        capabilities: AgentCapabilities {
+            workspace: true,
+            models: true,
+            streaming: true,
+            stop: true,
+            resume: false,
+            tools: config
+                .as_ref()
+                .is_ok_and(|config| config.tools_mode == ToolsMode::ReadOnly),
+            approvals: false,
+        },
+        supported: vec![
+            "getStatus",
+            "listModels",
+            "listSessions",
+            "selectWorkspace",
+            "startSession",
+            "send",
+            "stop",
+            "close",
+            "onEvent",
+        ],
+        unsupported: vec!["resume", "toolApproval", "writeTools"],
+        sessions,
+        last_error: config.err().or(runtime_error),
+    }
+}
