diff --git a/src-tauri/src/agent_runtime.rs b/src-tauri/src/agent_runtime.rs
new file mode 100644
index 0000000..5dc39a1
--- /dev/null
+++ b/src-tauri/src/agent_runtime.rs
@@ -0,0 +1,2028 @@
+//! Narrow, local-only adapter for the Claritide agent runtime proof of concept.
+//!
+//! The browser never supplies an executable, command-line flag, working-directory
+//! path, or environment variable. A native folder picker mints an opaque workspace
+//! handle, and the runtime executable is enabled only through explicit development
+//! environment variables. This keeps the remote Claritide workspace unable to turn
+//! Tauri IPC into a generic shell.
+
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Value};
+use std::collections::{HashMap, HashSet, VecDeque};
+use std::env;
+use std::fs::{canonicalize, create_dir_all};
+use std::io::{Read, Write};
+use std::path::{Path, PathBuf};
+use std::process::{Child, ChildStdin, Command, ExitStatus, Stdio};
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::mpsc::{sync_channel, Receiver, SyncSender, TrySendError};
+use std::sync::{Arc, Mutex, OnceLock};
+use std::thread;
+use std::time::{Duration, SystemTime, UNIX_EPOCH};
+use tauri::AppHandle;
+use tauri_plugin_dialog::DialogExt;
+
+#[cfg(target_os = "windows")]
+use std::os::windows::process::CommandExt;
+
+pub const CAPABILITY_VERSION: u32 = 1;
+const MAX_SESSIONS: usize = 1;
+const MAX_EVENTS_PER_SESSION: usize = 512;
+const MAX_EVENTS_PER_POLL: usize = 100;
+const MAX_EVENT_PAYLOAD_BYTES: usize = 512 * 1024;
+const MAX_QUEUED_EVENT_BYTES: usize = 8 * 1024 * 1024;
+const MAX_STDERR_LINES: usize = 20;
+const MAX_MESSAGE_BYTES: usize = 64 * 1024;
+const MAX_ASSISTANT_TEXT_CHARS: usize = 64 * 1024;
+const MAX_STDOUT_LINE_BYTES: usize = 16 * 1024 * 1024;
+const MAX_PROTOCOL_LINE_CHARS: usize = 2048;
+const MAX_SEEN_PROTOCOL_IDS: usize = 2048;
+const RUNTIME_EXECUTABLE_ENV: &str = "CLARITIDE_AGENT_EXECUTABLE";
+const RUNTIME_ENTRYPOINT_ENV: &str = "CLARITIDE_AGENT_ENTRYPOINT";
+const RUNTIME_MODELS_ENV: &str = "CLARITIDE_AGENT_ALLOWED_MODELS";
+const RUNTIME_TOOLS_ENV: &str = "CLARITIDE_AGENT_TOOLS_MODE";
+
+static RUNTIME: OnceLock<AgentRuntime> = OnceLock::new();
+static HANDLE_COUNTER: AtomicU64 = AtomicU64::new(1);
+static UUID_COUNTER: AtomicU64 = AtomicU64::new(1);
+static PROCESS_GENERATION: AtomicU64 = AtomicU64::new(1);
+
+#[derive(Debug, Clone)]
+struct RuntimeConfig {
+    executable: PathBuf,
+    entrypoint: Option<PathBuf>,
+    models: Vec<String>,
+    tools_mode: ToolsMode,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum ToolsMode {
+    Disabled,
+    ReadOnly,
+}
+
+impl ToolsMode {
+    fn from_env() -> Result<Self, String> {
+        match env::var(RUNTIME_TOOLS_ENV)
+            .unwrap_or_else(|_| "disabled".to_string())
+            .trim()
+            .to_ascii_lowercase()
+            .as_str()
+        {
+            "" | "disabled" | "none" => Ok(Self::Disabled),
+            "readonly" | "read-only" => Ok(Self::ReadOnly),
+            _ => Err(format!(
+                "{RUNTIME_TOOLS_ENV} must be 'disabled' or 'readonly'"
+            )),
+        }
+    }
+
+    fn as_str(self) -> &'static str {
+        match self {
+            Self::Disabled => "disabled",
+            Self::ReadOnly => "readonly",
+        }
+    }
+
+    fn cli_value(self) -> &'static str {
+        match self {
+            Self::Disabled => "",
+            Self::ReadOnly => "Read,Glob,Grep",
+        }
+    }
+}
+
+#[derive(Default)]
+struct AgentRuntime {
+    state: Mutex<RuntimeState>,
+}
+
+#[derive(Default)]
+struct RuntimeState {
+    workspaces: HashMap<String, PathBuf>,
+    sessions: HashMap<String, SessionRecord>,
+    last_error: Option<String>,
+}
+
+struct SessionRecord {
+    generation: u64,
+    child: Arc<Mutex<Child>>,
+    writer: Option<SyncSender<Value>>,
+    phase: SessionPhase,
+    reaped: bool,
+    workspace_id: String,
+    workspace_name: String,
+    model: String,
+    events: VecDeque<AgentEvent>,
+    queued_event_bytes: usize,
+    stderr: VecDeque<String>,
+    pending_interrupts: HashSet<String>,
+    session_started_emitted: bool,
+    canonical_assistant_seen: bool,
+    turn_active: bool,
+    next_seq: u64,
+    seen_message_ids: HashSet<String>,
+    seen_message_order: VecDeque<String>,
+    seen_request_ids: HashSet<String>,
+    seen_request_order: VecDeque<String>,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum SessionPhase {
+    Running,
+    Closing,
+    Stopped,
+    Failed,
+}
+
+#[derive(Debug, PartialEq, Eq)]
+enum BoundedLine {
+    Line(String),
+    Oversized,
+    InvalidUtf8,
+    ReadError,
+    Truncated(String),
+}
+
+impl SessionPhase {
+    fn as_str(self) -> &'static str {
+        match self {
+            Self::Running => "running",
+            Self::Closing => "closing",
+            Self::Stopped => "stopped",
+            Self::Failed => "failed",
+        }
+    }
+}
+
+#[derive(Debug, Clone, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct AgentEvent {
+    event_id: u64,
+    seq: u64,
+    session_id: String,
+    #[serde(rename = "type")]
+    kind: String,
+    timestamp_ms: u64,
+    payload: Value,
+    #[serde(skip)]
+    queued_bytes: usize,
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub(crate) struct NormalizedEventDraft {
+    pub(crate) kind: &'static str,
+    pub(crate) payload: Value,
+}
+
+#[derive(Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct AgentStatus {
+    capability_version: u32,
+    available: bool,
+    runtime: &'static str,
+    tools_mode: String,
+    allowed_models: Vec<String>,
+    capabilities: AgentCapabilities,
+    supported: Vec<&'static str>,
+    unsupported: Vec<&'static str>,
+    sessions: Vec<AgentSessionSummary>,
+    last_error: Option<String>,
+}
+
+#[derive(Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct AgentCapabilities {
+    workspace: bool,
+    models: bool,
+    streaming: bool,
+    stop: bool,
+    resume: bool,
+    tools: bool,
+    approvals: bool,
+}
+
+#[derive(Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct AgentSessionSummary {
+    session_id: String,
+    phase: String,
+    workspace_id: String,
+    workspace_name: String,
+    model: String,
+}
+
+#[derive(Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct AgentWorkspace {
+    id: String,
+    name: String,
+    path: String,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct AgentStartRequest {
+    client_session_id: String,
+    workspace: String,
+    #[serde(default)]
+    model: Option<String>,
+    #[serde(default)]
+    locale: Option<String>,
+}
+
+#[derive(Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct AgentStartResponse {
+    session_id: String,
+    model: String,
+    workspace: String,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct AgentSendRequest {
+    session_id: String,
+    content: String,
+}
+
+#[derive(Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct AgentSendResponse {
+    turn_id: String,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct AgentSessionRequest {
+    session_id: String,
+}
+
+fn runtime() -> &'static AgentRuntime {
+    RUNTIME.get_or_init(AgentRuntime::default)
+}
+
+fn lock_state() -> Result<std::sync::MutexGuard<'static, RuntimeState>, String> {
+    runtime()
+        .state
+        .lock()
+        .map_err(|_| "Claritide agent state is unavailable".to_string())
+}
+
+fn now_ms() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_millis() as u64
+}
+
+fn next_handle(prefix: &str) -> String {
+    let sequence = HANDLE_COUNTER.fetch_add(1, Ordering::Relaxed);
+    format!("{prefix}-{:x}-{sequence:x}", now_ms())
+}
+
+fn new_uuid_v4() -> String {
+    let timestamp = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_nanos();
+    let sequence = UUID_COUNTER.fetch_add(1, Ordering::Relaxed) as u128;
+    let raw = timestamp.rotate_left(37) ^ sequence.wrapping_mul(0x9e3779b97f4a7c15);
+    let part1 = (raw >> 96) as u32;
+    let part2 = ((raw >> 80) & 0xffff) as u16;
+    let part3 = (((raw >> 64) & 0x0fff) as u16) | 0x4000;
+    let part4 = (((raw >> 48) & 0x3fff) as u16) | 0x8000;
+    let part5 = raw & 0xffffffffffff;
+    format!("{part1:08x}-{part2:04x}-{part3:04x}-{part4:04x}-{part5:012x}")
+}
+
+fn validate_absolute_file(path: &Path, variable: &str) -> Result<PathBuf, String> {
+    if !path.is_absolute() {
+        return Err(format!("{variable} must be an absolute path"));
+    }
+    let resolved =
+        canonicalize(path).map_err(|error| format!("Unable to resolve {variable}: {error}"))?;
+    if !resolved.is_file() {
+        return Err(format!("{variable} does not point to a file"));
+    }
+    Ok(resolved)
+}
+
+fn valid_model_id(value: &str) -> bool {
+    value.len() <= 128
+        && value
+            .as_bytes()
+            .first()
+            .is_some_and(|byte| byte.is_ascii_alphanumeric())
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || b"._:/-".contains(&byte))
+}
+
+fn allowed_models() -> Result<Vec<String>, String> {
+    let configured = env::var(RUNTIME_MODELS_ENV).unwrap_or_else(|_| "default".to_string());
+    let mut models = Vec::new();
+    for candidate in configured
+        .split(',')
+        .map(str::trim)
+        .filter(|value| !value.is_empty())
+    {
+        if !valid_model_id(candidate) {
+            return Err(format!("Invalid model id in {RUNTIME_MODELS_ENV}"));
+        }
+        if !models.iter().any(|value| value == candidate) {
+            models.push(candidate.to_string());
+        }
+    }
+    if models.is_empty() || models.len() > 16 {
+        return Err(format!(
+            "{RUNTIME_MODELS_ENV} must contain 1 to 16 model ids"
+        ));
+    }
+    Ok(models)
+}
+
+fn runtime_config() -> Result<RuntimeConfig, String> {
+    let executable = env::var_os(RUNTIME_EXECUTABLE_ENV)
+        .ok_or_else(|| format!("{RUNTIME_EXECUTABLE_ENV} is not configured"))?;
+    let executable = validate_absolute_file(Path::new(&executable), RUNTIME_EXECUTABLE_ENV)?;
+    let entrypoint = env::var_os(RUNTIME_ENTRYPOINT_ENV)
+        .filter(|value| !value.is_empty())
+        .map(|value| validate_absolute_file(Path::new(&value), RUNTIME_ENTRYPOINT_ENV))
+        .transpose()?;
+    Ok(RuntimeConfig {
+        executable,
+        entrypoint,
+        models: allowed_models()?,
+        tools_mode: ToolsMode::from_env()?,
+    })
+}
+
+fn valid_session_id(value: &str) -> bool {
+    if value.len() != 36 {
+        return false;
+    }
+    value.bytes().enumerate().all(|(index, byte)| {
+        if matches!(index, 8 | 13 | 18 | 23) {
+            byte == b'-'
+        } else {
+            byte.is_ascii_hexdigit()
+        }
+    })
+}
+
+fn valid_tool_use_id(value: &str) -> bool {
+    !value.is_empty() && value.len() <= 256 && value.bytes().all(|byte| byte.is_ascii_graphic())
+}
+
+fn truncate_text(value: &str, limit: usize) -> String {
+    value.chars().take(limit).collect()
+}
+
+fn mismatched_session_id<'a>(value: &'a Value, expected: &str) -> Option<&'a str> {
+    value
+        .get("session_id")
+        .and_then(Value::as_str)
+        .filter(|session_id| !session_id.is_empty() && *session_id != expected)
+}
+
+fn remember_protocol_id(
+    seen: &mut HashSet<String>,
+    order: &mut VecDeque<String>,
+    value: &str,
+) -> bool {
+    if seen.contains(value) {
+        return false;
+    }
+    while order.len() >= MAX_SEEN_PROTOCOL_IDS {
+        if let Some(oldest) = order.pop_front() {
+            seen.remove(&oldest);
+        }
+    }
+    seen.insert(value.to_string());
+    order.push_back(value.to_string());
+    true
+}
+
+fn advance_seq(seq: &mut u64) -> u64 {
+    *seq = seq.saturating_add(1);
+    *seq
+}
+
+fn read_bounded_lines<R: Read>(
+    mut reader: R,
+    max_line_bytes: usize,
+    mut receive: impl FnMut(BoundedLine),
+) {
+    let mut chunk = [0_u8; 8192];
+    let mut line = Vec::new();
+    loop {
+        let count = match reader.read(&mut chunk) {
+            Ok(0) => break,
+            Ok(count) => count,
+            Err(_) => {
+                receive(BoundedLine::ReadError);
+                return;
+            }
+        };
+        for byte in &chunk[..count] {
+            if *byte == b'\n' {
+                if line.last() == Some(&b'\r') {
+                    line.pop();
+                }
+                match String::from_utf8(std::mem::take(&mut line)) {
+                    Ok(value) => receive(BoundedLine::Line(value)),
+                    Err(_) => receive(BoundedLine::InvalidUtf8),
+                }
+            } else if line.len() >= max_line_bytes {
+                // Notify at the boundary instead of scanning attacker-controlled
+                // bytes until a newline that may never arrive. The stdout
+                // callback quarantines and kills the bound child immediately.
+                receive(BoundedLine::Oversized);
+                return;
+            } else {
+                line.push(*byte);
+            }
+        }
+    }
+    if !line.is_empty() {
+        match String::from_utf8(line) {
+            Ok(value) => receive(BoundedLine::Truncated(value)),
+            Err(_) => receive(BoundedLine::InvalidUtf8),
+        }
+    }
+}
+
+fn compact_tool_result(block: &Value) -> Value {
+    let content = block.get("content");
+    let preview = match content {
+        Some(Value::String(value)) => truncate_text(value, 500),
+        Some(Value::Array(values)) => values
+            .iter()
+            .filter_map(|item| item.get("text").and_then(Value::as_str))
+            .take(3)
+            .collect::<Vec<_>>()
+            .join("\n")
+            .chars()
+            .take(500)
+            .collect(),
+        _ => String::new(),
+    };
+    json!({
+        "toolUseId": block.get("tool_use_id").and_then(Value::as_str),
+        "isError": block.get("is_error").and_then(Value::as_bool).unwrap_or(false),
+        "preview": preview,
+    })
+}
+
+fn result_fallback_text(value: &Value, canonical_assistant_seen: bool) -> Option<String> {
+    if canonical_assistant_seen
+        || value.get("type").and_then(Value::as_str) != Some("result")
+        || value.get("subtype").and_then(Value::as_str) != Some("success")
+        || value
+            .get("is_error")
+            .and_then(Value::as_bool)
+            .unwrap_or(false)
+    {
+        return None;
+    }
+    value
+        .get("result")
+        .and_then(Value::as_str)
+        .filter(|text| !text.is_empty())
+        .map(|text| truncate_text(text, MAX_ASSISTANT_TEXT_CHARS))
+}
+
+/// Convert one CCB stream-json stdout line into the stable Claritide event contract.
+/// Streaming deltas are provisional. A canonical `assistant_final` event carries the
+/// completed text and must replace (not append to) those deltas in the UI.
+pub(crate) fn normalize_ndjson_line(line: &str) -> Vec<NormalizedEventDraft> {
+    let value: Value = match serde_json::from_str(line) {
+        Ok(value) => value,
+        Err(_) => {
+            return vec![NormalizedEventDraft {
+                kind: "error",
+                payload: json!({
+                    "code": "invalid_ndjson",
+                    "message": "The configured agent runtime emitted invalid NDJSON",
+                    "preview": truncate_text(line, 256),
+                }),
+            }]
+        }
+    };
+
+    if !value.is_object() {
+        return vec![NormalizedEventDraft {
+            kind: "error",
+            payload: json!({
+                "code": "invalid_ndjson_message",
+                "message": "The configured agent runtime emitted an invalid protocol object",
+            }),
+        }];
+    }
+    // CCB can add forward-compatible diagnostics. Valid JSON objects without a
+    // known discriminator are ignored instead of ever becoming assistant text.
+    if value.get("type").and_then(Value::as_str).is_none() {
+        return Vec::new();
+    }
+
+    let mut events = Vec::new();
+    match value
+        .get("type")
+        .and_then(Value::as_str)
+        .unwrap_or_default()
+    {
+        "system" if value.get("subtype").and_then(Value::as_str) == Some("init") => {
+            events.push(NormalizedEventDraft {
+                kind: "session_started",
+                payload: json!({
+                    "model": value.get("model").and_then(Value::as_str),
+                    "tools": value.get("tools").cloned().unwrap_or_else(|| json!([])),
+                    "permissionMode": value.get("permissionMode")
+                        .or_else(|| value.get("permission_mode"))
+                        .and_then(Value::as_str),
+                }),
+            });
+        }
+        "stream_event" => {
+            let null = Value::Null;
+            let event = value.get("event").unwrap_or(&null);
+            match event
+                .get("type")
+                .and_then(Value::as_str)
+                .unwrap_or_default()
+            {
+                "content_block_delta" => {
+                    let delta = event.get("delta").unwrap_or(&null);
+                    if delta.get("type").and_then(Value::as_str) == Some("text_delta") {
+                        if let Some(text) = delta.get("text").and_then(Value::as_str) {
+                            if !text.is_empty() {
+                                events.push(NormalizedEventDraft {
+                                    kind: "text_delta",
+                                    payload: json!({ "text": text }),
+                                });
+                            }
+                        }
+                    }
+                }
+                "content_block_start" => {
+                    let block = event.get("content_block").unwrap_or(&null);
+                    if block.get("type").and_then(Value::as_str) == Some("tool_use") {
+                        events.push(NormalizedEventDraft {
+                            kind: "tool_started",
+                            payload: json!({
+                                "toolUseId": block.get("id").and_then(Value::as_str),
+                                "tool": block.get("name").and_then(Value::as_str),
+                            }),
+                        });
+                    }
+                }
+                _ => {}
+            }
+        }
+        "assistant" => {
+            let blocks = value
+                .get("message")
+                .and_then(|message| message.get("content"))
+                .and_then(Value::as_array);
+            if let Some(blocks) = blocks {
+                let text = blocks
+                    .iter()
+                    .filter(|block| block.get("type").and_then(Value::as_str) == Some("text"))
+                    .filter_map(|block| block.get("text").and_then(Value::as_str))
+                    .collect::<Vec<_>>()
+                    .join("");
+                if !text.is_empty() {
+                    events.push(NormalizedEventDraft {
+                        kind: "assistant_final",
+                        payload: json!({ "text": truncate_text(&text, MAX_ASSISTANT_TEXT_CHARS) }),
+                    });
+                }
+            }
+        }
+        "user" => {
+            let content = value
+                .get("message")
+                .and_then(|message| message.get("content"))
+                .and_then(Value::as_array);
+            if let Some(content) = content {
+                for block in content {
+                    if block.get("type").and_then(Value::as_str) == Some("tool_result") {
+                        events.push(NormalizedEventDraft {
+                            kind: "tool_completed",
+                            payload: compact_tool_result(block),
+                        });
+                    }
+                }
+            }
+        }
+        "result" => {
+            let subtype = value
+                .get("subtype")
+                .and_then(Value::as_str)
+                .unwrap_or("unknown");
+            if subtype == "success"
+                && !value
+                    .get("is_error")
+                    .and_then(Value::as_bool)
+                    .unwrap_or(false)
+            {
+                events.push(NormalizedEventDraft {
+                    kind: "turn_completed",
+                    payload: json!({
+                        "durationMs": value.get("duration_ms").and_then(Value::as_u64),
+                        "durationApiMs": value.get("duration_api_ms").and_then(Value::as_u64),
+                        "numTurns": value.get("num_turns").and_then(Value::as_u64),
+                        "totalCostUsd": value.get("total_cost_usd").and_then(Value::as_f64),
+                        "usage": value.get("usage").cloned().unwrap_or(Value::Null),
+                    }),
+                });
+            } else {
+                let message = value
+                    .get("errors")
+                    .and_then(Value::as_array)
+                    .and_then(|errors| errors.first())
+                    .and_then(Value::as_str)
+                    .unwrap_or("Agent turn failed");
+                events.push(NormalizedEventDraft {
+                    kind: "error",
+                    payload: json!({
+                        "code": subtype,
+                        "message": truncate_text(message, 1000),
+                        "terminal": true,
+                    }),
+                });
+            }
+        }
+        "control_request" => {
+            if value
+                .get("request")
+                .and_then(|request| request.get("subtype"))
+                .and_then(Value::as_str)
+                == Some("can_use_tool")
+            {
+                events.push(NormalizedEventDraft {
+                    kind: "error",
+                    payload: json!({
+                        "code": "tool_approval_unsupported",
+                        "message": "Tool approval is not available in agent capability v1",
+                        "terminal": false,
+                    }),
+                });
+            }
+        }
+        _ => {}
+    }
+    events
+}
+
+fn push_event_locked(state: &mut RuntimeState, session_id: &str, kind: &str, payload: Value) {
+    let Some(session) = state.sessions.get_mut(session_id) else {
+        return;
+    };
+    if kind == "session_started" {
+        if session.session_started_emitted {
+            return;
+        }
+        session.session_started_emitted = true;
+    }
+    let mut event_kind = kind.to_string();
+    let mut event_payload = payload;
+    let mut queued_bytes = serde_json::to_vec(&event_payload)
+        .map(|value| value.len())
+        .unwrap_or(MAX_EVENT_PAYLOAD_BYTES.saturating_add(1));
+    let payload_too_large = queued_bytes > MAX_EVENT_PAYLOAD_BYTES;
+    if payload_too_large {
+        event_kind = "error".to_string();
+        event_payload = json!({
+            "code": "event_payload_too_large",
+            "message": "The agent runtime emitted an event payload that exceeded the safety limit",
+        });
+        queued_bytes = serde_json::to_vec(&event_payload)
+            .map(|value| value.len())
+            .unwrap_or(0);
+    }
+    while session.events.len() >= MAX_EVENTS_PER_SESSION
+        || session.queued_event_bytes.saturating_add(queued_bytes) > MAX_QUEUED_EVENT_BYTES
+    {
+        let Some(discarded) = session.events.pop_front() else {
+            break;
+        };
+        session.queued_event_bytes = session
+            .queued_event_bytes
+            .saturating_sub(discarded.queued_bytes);
+    }
+    let seq = advance_seq(&mut session.next_seq);
+    session.queued_event_bytes = session.queued_event_bytes.saturating_add(queued_bytes);
+    session.events.push_back(AgentEvent {
+        event_id: HANDLE_COUNTER.fetch_add(1, Ordering::Relaxed),
+        seq,
+        session_id: session_id.to_string(),
+        kind: event_kind,
+        timestamp_ms: now_ms(),
+        payload: event_payload,
+        queued_bytes,
+    });
+    if payload_too_large {
+        session.phase = SessionPhase::Failed;
+        session.turn_active = false;
+        session.pending_interrupts.clear();
+        session.writer.take();
+        let mut child = session
+            .child
+            .lock()
+            .unwrap_or_else(|poisoned| poisoned.into_inner());
+        let _ = child.kill();
+    }
+}
+
+fn quarantine_session_locked(
+    state: &mut RuntimeState,
+    session_id: &str,
+    generation: u64,
+    code: &str,
+    message: &str,
+) {
+    if !state
+        .sessions
+        .get(session_id)
+        .is_some_and(|session| session.generation == generation && !session.reaped)
+    {
+        return;
+    }
+    push_event_locked(
+        state,
+        session_id,
+        "error",
+        json!({ "code": code, "message": message, "terminal": true }),
+    );
+    let child = state.sessions.get_mut(session_id).map(|session| {
+        session.phase = SessionPhase::Failed;
+        session.turn_active = false;
+        session.pending_interrupts.clear();
+        session.writer.take();
+        session.child.clone()
+    });
+    state.last_error = Some(message.to_string());
+    if let Some(child) = child {
+        let mut child = child
+            .lock()
+            .unwrap_or_else(|poisoned| poisoned.into_inner());
+        let _ = child.kill();
+    }
+}
+
+fn handle_stdout_line(session_id: &str, generation: u64, line: &str) {
+    let parsed = serde_json::from_str::<Value>(line).ok();
+    let Ok(mut state) = lock_state() else {
+        return;
+    };
+    if !state.sessions.get(session_id).is_some_and(|session| {
+        session.generation == generation
+            && !session.reaped
+            && matches!(session.phase, SessionPhase::Running | SessionPhase::Closing)
+    }) {
+        return;
+    }
+    if line.len() > MAX_STDOUT_LINE_BYTES {
+        quarantine_session_locked(
+            &mut state,
+            session_id,
+            generation,
+            "runtime_output_too_large",
+            "The agent runtime emitted an oversized protocol line",
+        );
+        return;
+    }
+    if !matches!(parsed.as_ref(), Some(value) if value.is_object()) {
+        quarantine_session_locked(
+            &mut state,
+            session_id,
+            generation,
+            "invalid_ndjson",
+            "The configured agent runtime emitted invalid NDJSON",
+        );
+        return;
+    }
+    if parsed
+        .as_ref()
+        .and_then(|value| mismatched_session_id(value, session_id))
+        .is_some()
+    {
+        quarantine_session_locked(
+            &mut state,
+            session_id,
+            generation,
+            "session_mismatch",
+            "The agent runtime emitted an event for a different session",
+        );
+        return;
+    }
+
+    let message_uuid = parsed.as_ref().and_then(|value| value.get("uuid"));
+    if message_uuid.is_some_and(|value| !value.as_str().is_some_and(valid_session_id)) {
+        quarantine_session_locked(
+            &mut state,
+            session_id,
+            generation,
+            "invalid_protocol_id",
+            "The agent runtime emitted an invalid message UUID",
+        );
+        return;
+    }
+    if let Some(uuid) = message_uuid.and_then(Value::as_str) {
+        if let Some(session) = state.sessions.get_mut(session_id) {
+            if !remember_protocol_id(
+                &mut session.seen_message_ids,
+                &mut session.seen_message_order,
+                uuid,
+            ) {
+                return;
+            }
+        }
+    }
+    let control_request_id = parsed
+        .as_ref()
+        .filter(|value| value.get("type").and_then(Value::as_str) == Some("control_request"))
+        .and_then(|value| value.get("request_id"));
+    if control_request_id.is_some_and(|value| !value.as_str().is_some_and(valid_session_id))
+        || parsed.as_ref().is_some_and(|value| {
+            value.get("type").and_then(Value::as_str) == Some("control_request")
+                && control_request_id.is_none()
+        })
+    {
+        quarantine_session_locked(
+            &mut state,
+            session_id,
+            generation,
+            "invalid_protocol_id",
+            "The agent runtime emitted an invalid control request ID",
+        );
+        return;
+    }
+    if let Some(request_id) = control_request_id.and_then(Value::as_str) {
+        if let Some(session) = state.sessions.get_mut(session_id) {
+            if !remember_protocol_id(
+                &mut session.seen_request_ids,
+                &mut session.seen_request_order,
+                request_id,
+            ) {
+                return;
+            }
+        }
+    }
+    let drafts = normalize_ndjson_line(line);
+    let has_canonical_assistant = drafts.iter().any(|draft| draft.kind == "assistant_final");
+    if has_canonical_assistant {
+        if let Some(session) = state.sessions.get_mut(session_id) {
+            session.canonical_assistant_seen = true;
+        }
+    }
+    let canonical_assistant_seen = state
+        .sessions
+        .get(session_id)
+        .is_some_and(|session| session.canonical_assistant_seen);
+    if let Some(text) = parsed
+        .as_ref()
+        .and_then(|value| result_fallback_text(value, canonical_assistant_seen))
+    {
+        push_event_locked(
+            &mut state,
+            session_id,
+            "assistant_final",
+            json!({ "text": text }),
+        );
+        if let Some(session) = state.sessions.get_mut(session_id) {
+            session.canonical_assistant_seen = true;
+        }
+    }
+    for draft in drafts {
+        push_event_locked(&mut state, session_id, draft.kind, draft.payload);
+    }
+
+    if let Some((request_id, "can_use_tool")) = parsed.as_ref().and_then(|value| {
+        if value.get("type").and_then(Value::as_str) != Some("control_request") {
+            return None;
+        }
+        Some((
+            value.get("request_id")?.as_str()?,
+            value.get("request")?.get("subtype")?.as_str()?,
+        ))
+    }) {
+        let tool_use_id = parsed
+            .as_ref()
+            .and_then(|value| value.get("request"))
+            .and_then(|request| request.get("tool_use_id"))
+            .and_then(Value::as_str);
+        if !tool_use_id.is_some_and(valid_tool_use_id) {
+            quarantine_session_locked(
+                &mut state,
+                session_id,
+                generation,
+                "invalid_tool_use_id",
+                "The agent runtime emitted an invalid tool-use ID",
+            );
+            return;
+        }
+        let write_error = state.sessions.get_mut(session_id).and_then(|session| {
+            write_control(
+                session,
+                json!({
+                    "type": "control_response",
+                    "response": {
+                        "subtype": "success",
+                        "request_id": request_id,
+                        "response": {
+                            "behavior": "deny",
+                            "message": "Claritide agent capability v1 does not support tool approvals",
+                            "interrupt": false,
+                            "toolUseID": tool_use_id.unwrap_or_default(),
+                        },
+                    },
+                }),
+            )
+            .err()
+        });
+        if let Some(error) = write_error {
+            if state.sessions.get(session_id).is_some_and(|session| {
+                session.generation == generation && session.phase == SessionPhase::Running
+            }) {
+                quarantine_session_locked(
+                    &mut state,
+                    session_id,
+                    generation,
+                    "runtime_input_failed",
+                    &error,
+                );
+            }
+            return;
+        }
+    }
+
+    if let Some((request_id, succeeded)) = parsed.as_ref().and_then(|value| {
+        if value.get("type").and_then(Value::as_str) != Some("control_response") {
+            return None;
+        }
+        let response = value.get("response")?;
+        Some((
+            response.get("request_id")?.as_str()?.to_string(),
+            response.get("subtype").and_then(Value::as_str) == Some("success"),
+        ))
+    }) {
+        let interrupted = state
+            .sessions
+            .get_mut(session_id)
+            .is_some_and(|session| session.pending_interrupts.remove(&request_id));
+        if interrupted && succeeded {
+            push_event_locked(
+                &mut state,
+                session_id,
+                "stopped",
+                json!({ "reason": "user_interrupt", "settling": true }),
+            );
+        } else if interrupted {
+            push_event_locked(
+                &mut state,
+                session_id,
+                "error",
+                json!({
+                    "code": "interrupt_failed",
+                    "message": "The agent runtime rejected the stop request",
+                    "terminal": false,
+                }),
+            );
+        }
+    }
+
+    if parsed
+        .as_ref()
+        .is_some_and(|value| value.get("type").and_then(Value::as_str) == Some("result"))
+    {
+        if let Some(session) = state.sessions.get_mut(session_id) {
+            session.turn_active = false;
+            session.pending_interrupts.clear();
+        }
+    }
+}
+
+fn record_stderr(session_id: &str, generation: u64, line: &str) {
+    let Ok(mut state) = lock_state() else {
+        return;
+    };
+    let Some(session) = state.sessions.get_mut(session_id) else {
+        return;
+    };
+    if session.generation != generation
+        || session.reaped
+        || !matches!(session.phase, SessionPhase::Running | SessionPhase::Closing)
+    {
+        return;
+    }
+    while session.stderr.len() >= MAX_STDERR_LINES {
+        session.stderr.pop_front();
+    }
+    session
+        .stderr
+        .push_back(truncate_text(line, MAX_PROTOCOL_LINE_CHARS));
+}
+
+fn handle_process_exit(session_id: &str, generation: u64, result: Result<ExitStatus, String>) {
+    let Ok(mut state) = lock_state() else {
+        return;
+    };
+    let (phase, stderr) = match state.sessions.get(session_id) {
+        Some(session) if session.generation == generation => (
+            session.phase,
+            session
+                .stderr
+                .iter()
+                .cloned()
+                .collect::<Vec<_>>()
+                .join("\n"),
+        ),
+        None => return,
+        Some(_) => return,
+    };
+    if phase == SessionPhase::Failed {
+        if let Some(session) = state.sessions.get_mut(session_id) {
+            session.reaped = true;
+            session.writer.take();
+        }
+        return;
+    }
+    match result {
+        Ok(status) if status.success() || phase == SessionPhase::Closing => {
+            if let Some(session) = state.sessions.get_mut(session_id) {
+                session.phase = SessionPhase::Stopped;
+                session.turn_active = false;
+                session.reaped = true;
+                session.writer.take();
+            }
+            push_event_locked(
+                &mut state,
+                session_id,
+                "stopped",
+                json!({ "reason": if phase == SessionPhase::Closing { "closed" } else { "runtime_exit" } }),
+            );
+        }
+        Ok(status) => {
+            if let Some(session) = state.sessions.get_mut(session_id) {
+                session.phase = SessionPhase::Failed;
+                session.turn_active = false;
+                session.reaped = true;
+                session.writer.take();
+            }
+            let message = if stderr.is_empty() {
+                format!("Agent runtime exited with {status}")
+            } else {
+                format!(
+                    "Agent runtime exited with {status}: {}",
+                    truncate_text(&stderr, 1000)
+                )
+            };
+            state.last_error = Some(message.clone());
+            push_event_locked(
+                &mut state,
+                session_id,
+                "error",
+                json!({ "code": "runtime_exit", "message": message, "terminal": true }),
+            );
+        }
+        Err(message) => {
+            if let Some(session) = state.sessions.get_mut(session_id) {
+                session.phase = SessionPhase::Failed;
+                session.turn_active = false;
+                session.reaped = true;
+                session.writer.take();
+            }
+            state.last_error = Some(message.clone());
+            push_event_locked(
+                &mut state,
+                session_id,
+                "error",
+                json!({ "code": "runtime_wait_failed", "message": message, "terminal": true }),
+            );
+        }
+    }
+}
+
+fn spawn_readers(
+    session_id: String,
+    generation: u64,
+    stdout: std::process::ChildStdout,
+    stderr: std::process::ChildStderr,
+    child: Arc<Mutex<Child>>,
+) {
+    let (reader_done, reader_done_receiver) = sync_channel(2);
+    let stdout_session = session_id.clone();
+    let stdout_done = reader_done.clone();
+    thread::spawn(move || {
+        read_bounded_lines(stdout, MAX_STDOUT_LINE_BYTES, |item| match item {
+            BoundedLine::Line(line) => handle_stdout_line(&stdout_session, generation, &line),
+            BoundedLine::Truncated(_) => {
+                if let Ok(mut state) = lock_state() {
+                    quarantine_session_locked(
+                        &mut state,
+                        &stdout_session,
+                        generation,
+                        "truncated_ndjson",
+                        "The agent runtime exited with an incomplete NDJSON line",
+                    );
+                }
+            }
+            BoundedLine::Oversized | BoundedLine::InvalidUtf8 | BoundedLine::ReadError => {
+                if let Ok(mut state) = lock_state() {
+                    quarantine_session_locked(
+                        &mut state,
+                        &stdout_session,
+                        generation,
+                        "invalid_runtime_output",
+                        "The agent runtime emitted unsafe protocol output",
+                    );
+                }
+            }
+        });
+        let _ = stdout_done.try_send(());
+    });
+
+    let stderr_session = session_id.clone();
+    let stderr_done = reader_done.clone();
+    thread::spawn(move || {
+        read_bounded_lines(stderr, MAX_PROTOCOL_LINE_CHARS, |item| match item {
+            BoundedLine::Line(line) | BoundedLine::Truncated(line) => {
+                record_stderr(&stderr_session, generation, &line)
+            }
+            BoundedLine::Oversized => {
+                if let Ok(mut state) = lock_state() {
+                    quarantine_session_locked(
+                        &mut state,
+                        &stderr_session,
+                        generation,
+                        "unsafe_runtime_stderr",
+                        "The agent runtime emitted an oversized stderr line",
+                    );
+                }
+            }
+            BoundedLine::InvalidUtf8 | BoundedLine::ReadError => {
+                if let Ok(mut state) = lock_state() {
+                    quarantine_session_locked(
+                        &mut state,
+                        &stderr_session,
+                        generation,
+                        "unsafe_runtime_stderr",
+                        "The agent runtime emitted unreadable stderr output",
+                    );
+                }
+            }
+        });
+        let _ = stderr_done.try_send(());
+    });
+    drop(reader_done);
+
+    thread::spawn(move || {
+        let mut process_status_error_reported = false;
+        let result = loop {
+            let status = child
+                .lock()
+                .unwrap_or_else(|poisoned| poisoned.into_inner())
+                .try_wait()
+                .map_err(|error| format!("Unable to read agent process status: {error}"));
+            match status {
+                Ok(Some(status)) => break Ok(status),
+                Ok(None) => thread::sleep(Duration::from_millis(100)),
+                Err(error) => {
+                    if !process_status_error_reported {
+                        process_status_error_reported = true;
+                        if let Ok(mut state) = lock_state() {
+                            quarantine_session_locked(
+                                &mut state,
+                                &session_id,
+                                generation,
+                                "runtime_wait_failed",
+                                &error,
+                            );
+                        }
+                    }
+                    // Do not release the one-process slot until the child has
+                    // actually been reaped. Never hold the child mutex across a
+                    // blocking wait: retry kill and nonblocking try_wait instead.
+                    {
+                        let mut child = child
+                            .lock()
+                            .unwrap_or_else(|poisoned| poisoned.into_inner());
+                        let _ = child.kill();
+                    }
+                    thread::sleep(Duration::from_secs(1));
+                }
+            }
+        };
+        // Descendants of an external development runtime could inherit a pipe
+        // and keep it open after the tracked child exits. Bound the drain wait;
+        // generation checks make any detached late reader unable to affect a
+        // replacement session.
+        for _ in 0..2 {
+            if reader_done_receiver
+                .recv_timeout(Duration::from_millis(500))
+                .is_err()
+            {
+                break;
+            }
+        }
+        handle_process_exit(&session_id, generation, result);
+    });
+}
+
+fn spawn_writer(
+    session_id: String,
+    generation: u64,
+    mut stdin: ChildStdin,
+    receiver: Receiver<Value>,
+) {
+    thread::spawn(move || {
+        while let Ok(value) = receiver.recv() {
+            let result = serde_json::to_string(&value)
+                .map_err(|error| format!("Unable to encode agent control message: {error}"))
+                .and_then(|serialized| {
+                    stdin
+                        .write_all(serialized.as_bytes())
+                        .and_then(|_| stdin.write_all(b"\n"))
+                        .and_then(|_| stdin.flush())
+                        .map_err(|error| format!("Unable to write to agent runtime: {error}"))
+                });
+            if let Err(error) = result {
+                if let Ok(mut state) = lock_state() {
+                    if state.sessions.get(&session_id).is_some_and(|session| {
+                        session.generation == generation && session.phase == SessionPhase::Running
+                    }) {
+                        quarantine_session_locked(
+                            &mut state,
+                            &session_id,
+                            generation,
+                            "runtime_input_failed",
+                            &error,
+                        );
+                    }
+                }
+                break;
+            }
+        }
+    });
+}
+
+fn write_control(session: &mut SessionRecord, value: Value) -> Result<(), String> {
+    let writer = session
+        .writer
+        .as_ref()
+        .ok_or_else(|| "Agent input stream is unavailable".to_string())?;
+    writer.try_send(value).map_err(|error| match error {
+        TrySendError::Full(_) => "Agent input queue is full".to_string(),
+        TrySendError::Disconnected(_) => "Agent input stream is unavailable".to_string(),
+    })
+}
+
+fn user_message(session_id: &str, turn_id: &str, content: &str) -> Value {
+    json!({
+        "type": "user",
+        "message": {
+            "role": "user",
+            "content": [{ "type": "text", "text": content }],
+        },
+        "parent_tool_use_id": Value::Null,
+        "session_id": session_id,
+        "uuid": turn_id,
+    })
+}
+
+fn runtime_args(session_id: &str, model: &str, tools_mode: ToolsMode) -> Vec<String> {
+    let mut args = vec![
+        "--print".to_string(),
+        // Print mode implicitly trusts the working directory. Bare mode plus
+        // an empty settings-source list prevents project/user hooks, plugins,
+        // MCP discovery, CLAUDE.md and slash-command startup behavior from
+        // turning a selected repository into code execution before approval.
+        "--bare".to_string(),
+        "--setting-sources".to_string(),
+        "".to_string(),
+        "--disable-slash-commands".to_string(),
+        // CCB hard-fails stream-json output without --verbose. This does not
+        // enable Claritide logging of stdout or stderr.
+        "--verbose".to_string(),
+        "--session-id".to_string(),
+        session_id.to_string(),
+        "--input-format".to_string(),
+        "stream-json".to_string(),
+        "--output-format".to_string(),
+        "stream-json".to_string(),
+        "--include-partial-messages".to_string(),
+        "--replay-user-messages".to_string(),
+        "--permission-mode".to_string(),
+        "default".to_string(),
+        // Without --sdk-url CCB does not automatically choose StructuredIO for
+        // permission prompts. The stdio handler is required so every tool request
+        // remains under Claritide control.
+        "--permission-prompt-tool".to_string(),
+        "stdio".to_string(),
+        "--tools".to_string(),
+        tools_mode.cli_value().to_string(),
+    ];
+    if model != "default" {
+        args.push("--model".to_string());
+        args.push(model.to_string());
+    }
+    args
+}
