+fn start_sync_scheduler(port: u16) {
+    let (sender, receiver) = mpsc::sync_channel(1);
+    if SYNC_TRIGGER.set(sender).is_err() {
+        return;
+    }
+
+    thread::spawn(move || {
+        while let Err(error) = wait_for_local_server(port) {
+            update_sync_runtime(|state| state.last_error = Some(error.clone()));
+            warn!("{error}; retrying local server readiness");
+            thread::sleep(Duration::from_secs(15));
+        }
+        // Never upload an old on-disk identity until the authenticated workspace
+        // explicitly resumes it. This closes the cold-start/logout race.
+        if receiver.recv().is_err() {
+            return;
+        }
+        loop {
+            // Coalesce any number of requests into one run. The worker waits for
+            // each child to exit, so state.json and the canonical outbox never
+            // have two desktop-managed sync processes writing at the same time.
+            while receiver.try_recv().is_ok() {}
+            let config_ready = !sync_rebind_pending_path().exists()
+                && match load_validated_sync_config() {
+                    Ok(Some(_)) => true,
+                    Ok(None) => false,
+                    Err(error) => {
+                        update_sync_runtime(|state| state.last_error = Some(error));
+                        false
+                    }
+                };
+            if sync_paused_path().exists() || !config_ready {
+                match receiver.recv() {
+                    Ok(()) => continue,
+                    Err(_) => break,
+                }
+            }
+            update_sync_runtime(|state| {
+                state.running = true;
+                state.bucket_ready = false;
+                state.last_attempt_at_ms = Some(now_unix_ms());
+                state.last_error = None;
+            });
+            let retry_after = match run_sync_once(port) {
+                Ok(true) => {
+                    update_sync_runtime(|state| {
+                        state.running = false;
+                        state.last_success_at_ms = Some(now_unix_ms());
+                        state.last_error = None;
+                    });
+                    Duration::from_secs(300)
+                }
+                Ok(false) => {
+                    update_sync_runtime(|state| {
+                        state.running = false;
+                        state.last_error = None;
+                    });
+                    continue;
+                }
+                Err(error) => {
+                    update_sync_runtime(|state| {
+                        state.running = false;
+                        state.last_error = Some(error.clone());
+                    });
+                    warn!("{error}");
+                    // Watchers and the network often warm up after the local API.
+                    // Retry cold-start failures quickly before the normal cadence.
+                    Duration::from_secs(15)
+                }
+            };
+            match receiver.recv_timeout(retry_after) {
+                Ok(()) | Err(mpsc::RecvTimeoutError::Timeout) => {}
+                Err(mpsc::RecvTimeoutError::Disconnected) => break,
+            }
+        }
+    });
+}
