+        let failed: serde_json::Value = serde_json::from_str(
+            r#"{"type":"result","subtype":"success","is_error":true,"result":"must not render"}"#,
+        )
+        .unwrap();
+        assert_eq!(result_fallback_text(&failed, false), None);
+    }
+
+    #[test]
+    fn ccb_text_fixture_has_provisional_and_canonical_text_without_duplication() {
+        let fixture = include_str!("../tests/fixtures/ccb-text-turn.ndjson");
+        let events = fixture
+            .lines()
+            .flat_map(normalize_ndjson_line)
+            .collect::<Vec<_>>();
+        let provisional = events
+            .iter()
+            .filter(|event| event.kind == "text_delta")
+            .filter_map(|event| event.payload["text"].as_str())
+            .collect::<String>();
+        assert_eq!(provisional, "Hello world");
+        let finals = events
+            .iter()
+            .filter(|event| event.kind == "assistant_final")
+            .collect::<Vec<_>>();
+        assert_eq!(finals.len(), 1);
+        assert_eq!(finals[0].payload["text"], "Hello world");
+        assert_eq!(
+            events
+                .iter()
+                .filter(|event| event.kind == "turn_completed")
+                .count(),
+            1
+        );
+    }
+
+    #[test]
+    fn ccb_tool_fixture_never_treats_tool_input_as_text() {
+        let fixture = include_str!("../tests/fixtures/ccb-tool-permission.ndjson");
+        let events = fixture
+            .lines()
+            .flat_map(normalize_ndjson_line)
+            .collect::<Vec<_>>();
+        assert_eq!(
+            events
+                .iter()
+                .filter(|event| event.kind == "tool_started")
+                .count(),
+            1
+        );
+        assert_eq!(
+            events
+                .iter()
+                .filter(|event| event.kind == "tool_completed")
+                .count(),
+            1
+        );
+        assert_eq!(
+            events
+                .iter()
+                .filter(|event| event.kind == "text_delta")
+                .count(),
+            0
+        );
+        assert_eq!(
+            events
+                .iter()
+                .filter(|event| event.payload["code"] == "tool_approval_unsupported")
+                .count(),
+            1
+        );
+    }
+
+    #[test]
+    fn ccb_error_fixture_marks_is_error_success_as_failure_and_ignores_unknown_json() {
+        let fixture = include_str!("../tests/fixtures/ccb-control-and-errors.ndjson");
+        let lines = fixture.lines().collect::<Vec<_>>();
+        let first = normalize_ndjson_line(lines[2]);
+        assert_eq!(first[0].kind, "error");
+        assert_eq!(first[0].payload["code"], "success");
+        let unknown = normalize_ndjson_line(lines[5]);
+        assert!(unknown.is_empty());
+        let polluted = normalize_ndjson_line(lines[6]);
+        assert_eq!(polluted[0].payload["code"], "invalid_ndjson");
+    }
+
+    #[test]
+    fn session_binding_and_protocol_ids_are_strict_and_idempotent() {
+        let foreign: serde_json::Value =
+            serde_json::from_str(r#"{"session_id":"99999999-9999-4999-8999-999999999999"}"#)
+                .unwrap();
+        assert_eq!(
+            mismatched_session_id(&foreign, "11111111-1111-4111-8111-111111111111"),
+            Some("99999999-9999-4999-8999-999999999999")
+        );
+
+        let mut seen = HashSet::new();
+        let mut order = VecDeque::new();
+        assert!(remember_protocol_id(&mut seen, &mut order, "uuid-1"));
+        assert!(!remember_protocol_id(&mut seen, &mut order, "uuid-1"));
+        let mut seq = 0;
+        assert_eq!(advance_seq(&mut seq), 1);
+        assert_eq!(advance_seq(&mut seq), 2);
+    }
+}
