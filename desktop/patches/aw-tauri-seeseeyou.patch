+#[tauri::command]
+pub async fn agent_select_workspace(app: AppHandle) -> Result<Option<AgentWorkspace>, String> {
+    let selected = app
+        .dialog()
+        .file()
+        .set_title("Choose a Claritide agent workspace")
+        .blocking_pick_folder();
+    let Some(selected) = selected else {
+        return Ok(None);
+    };
+    let path = selected
+        .into_path()
+        .map_err(|error| format!("Unable to use selected workspace: {error}"))?;
+    let path = canonicalize(path)
+        .map_err(|error| format!("Unable to resolve selected workspace: {error}"))?;
+    if !path.is_dir() {
+        return Err("The selected workspace is not a directory".to_string());
+    }
+    let id = next_handle("workspace");
+    let name = path
+        .file_name()
+        .and_then(|value| value.to_str())
+        .filter(|value| !value.is_empty())
+        .unwrap_or("Workspace")
+        .to_string();
+    lock_state()?.workspaces.insert(id.clone(), path.clone());
+    Ok(Some(AgentWorkspace {
+        id,
+        name,
+        path: path.to_string_lossy().into_owned(),
+    }))
+}
