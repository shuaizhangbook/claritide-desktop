+#[tauri::command]
+fn get_sync_status() -> DesktopSyncStatus {
+    let binary_ready = sync_binary_path().is_some_and(|path| path.exists());
+    let paused = sync_paused_path().exists();
+    let config_result = load_validated_sync_config();
+    if let Err(error) = &config_result {
+        update_sync_runtime(|state| state.last_error = Some(error.clone()));
+    }
+    let config = if sync_rebind_pending_path().exists() {
+        None
+    } else {
+        config_result.ok().flatten()
+    };
+    let runtime = SYNC_RUNTIME
+        .get_or_init(|| Mutex::new(SyncRuntimeState::default()))
+        .lock()
+        .ok();
+    DesktopSyncStatus {
+        desktop_version: env!("CARGO_PKG_VERSION"),
+        bridge_protocol: SEESEEYOU_BRIDGE_PROTOCOL,
+        configured: config.is_some(),
+        paused,
+        binary_ready,
+        device_id: config.as_ref().map(|value| value.device_id.clone()),
+        employee_id: config.as_ref().map(|value| value.employee_id.clone()),
+        team_id: config.as_ref().and_then(|value| value.team_id.clone()),
+        running: runtime.as_ref().is_some_and(|value| value.running),
+        bucket_ready: runtime.as_ref().is_some_and(|value| value.bucket_ready),
+        last_attempt_at_ms: runtime.as_ref().and_then(|value| value.last_attempt_at_ms),
+        last_success_at_ms: runtime.as_ref().and_then(|value| value.last_success_at_ms),
+        last_error: runtime.as_ref().and_then(|value| value.last_error.clone()),
+    }
+}
