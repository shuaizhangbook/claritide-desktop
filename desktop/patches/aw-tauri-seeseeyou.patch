@@ -0,0 +1,69 @@
+use log::{info, warn};
+use tauri::{AppHandle, Manager, Url, WebviewUrl, WebviewWindowBuilder};
+
+pub const WINDOW_LABEL: &str = "agent-workbench";
+pub const URI_SCHEME: &str = "claritide-agent";
+pub const HTML: &str = include_str!("../assets/agent-workbench.html");
+
+fn navigation_allowed(url: &Url) -> bool {
+    url.port().is_none()
+        && matches!(
+            (url.scheme(), url.host_str()),
+            (URI_SCHEME, Some("localhost")) | ("http", Some("claritide-agent.localhost"))
+        )
+}
+
+pub fn open(app: &AppHandle) -> Result<(), String> {
+    if let Some(window) = app.get_webview_window(WINDOW_LABEL) {
+        window.show().map_err(|error| error.to_string())?;
+        window.set_focus().map_err(|error| error.to_string())?;
+        return Ok(());
+    }
+    let url = format!("{URI_SCHEME}://localhost/")
+        .parse()
+        .map_err(|error| format!("Unable to build local agent URL: {error}"))?;
+    WebviewWindowBuilder::new(app, WINDOW_LABEL, WebviewUrl::CustomProtocol(url))
+        .title("Claritide AI Workbench")
+        .inner_size(1080.0, 760.0)
+        .min_inner_size(820.0, 600.0)
+        .center()
+        .visible(true)
+        .initialization_script(include_str!("agent_workbench_bridge.js"))
+        .on_navigation(navigation_allowed)
+        .build()
+        .map_err(|error| format!("Unable to open Claritide AI Workbench: {error}"))?;
+    info!("Opened isolated Claritide agent workbench");
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::navigation_allowed;
+
+    #[test]
+    fn workbench_navigation_never_allows_remote_content() {
+        assert!(navigation_allowed(
+            &"claritide-agent://localhost/".parse().unwrap()
+        ));
+        assert!(navigation_allowed(
+            &"http://claritide-agent.localhost/".parse().unwrap()
+        ));
+        assert!(!navigation_allowed(
+            &"https://watch.sding.me/admin/assistant/".parse().unwrap()
+        ));
+        assert!(!navigation_allowed(
+            &"http://claritide-agent.localhost:8765/".parse().unwrap()
+        ));
+        assert!(!navigation_allowed(
+            &"file:///tmp/index.html".parse().unwrap()
+        ));
+    }
+}
+
+#[tauri::command]
+pub async fn open_agent_workbench(app: AppHandle) -> Result<(), String> {
+    open(&app).map_err(|error| {
+        warn!("{error}");
+        error
+    })
+}
