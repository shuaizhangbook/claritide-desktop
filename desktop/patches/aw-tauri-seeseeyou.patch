+[[permission]]
+identifier = "allow-open-agent-workbench"
+description = "Allows the Claritide workspace to open the isolated local agent window."
+commands.allow = ["open_agent_workbench"]
+
+[[permission]]
+identifier = "allow-agent-get-status"
+description = "Allows the local agent workbench to inspect the configured development runtime."
+commands.allow = ["agent_get_status"]
+
+[[permission]]
+identifier = "allow-agent-select-workspace"
+description = "Allows the local agent workbench to request an opaque handle from a native folder picker."
+commands.allow = ["agent_select_workspace"]
+
+[[permission]]
+identifier = "allow-agent-start"
+description = "Allows the local agent workbench to start the fixed development runtime in an approved workspace."
+commands.allow = ["agent_start"]
+
+[[permission]]
+identifier = "allow-agent-send"
+description = "Allows the local agent workbench to send a bounded user message to an active session."
+commands.allow = ["agent_send"]
+
+[[permission]]
+identifier = "allow-agent-interrupt"
+description = "Allows the local agent workbench to interrupt the current turn without killing the session."
+commands.allow = ["agent_interrupt"]
+
+[[permission]]
+identifier = "allow-agent-close"
+description = "Allows the local agent workbench to close its active local session."
+commands.allow = ["agent_close"]
+
+[[permission]]
+identifier = "allow-agent-poll-events"
+description = "Allows the local agent workbench to drain normalized runtime events."
+commands.allow = ["agent_poll_events"]
