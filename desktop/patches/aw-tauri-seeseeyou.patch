+        return Ok(false);
+    }
+    update_sync_runtime(|state| state.bucket_ready = true);
+    let config_path = sync_config_path();
+    let binary_path =
+        sync_binary_path().ok_or_else(|| "Unable to locate sync program".to_string())?;
+    if !binary_path.exists() {
+        return Err("Claritide sync program is missing".to_string());
+    }
+    let mut command = Command::new(binary_path);
+    command.arg("--config").arg(config_path);
+    #[cfg(target_os = "windows")]
+    command.creation_flags(0x08000000);
+    let mut child = command
+        .spawn()
+        .map_err(|error| format!("Unable to start Claritide sync: {error}"))?;
+    loop {
+        if generation != SYNC_GENERATION.load(Ordering::SeqCst) || sync_paused_path().exists() {
+            let _ = child.kill();
+            let _ = child.wait();
+            return Ok(false);
+        }
+        let status = match child.try_wait() {
+            Ok(status) => status,
+            Err(error) => {
+                let _ = child.kill();
+                let _ = child.wait();
+                return Err(format!("Unable to read Claritide sync status: {error}"));
+            }
+        };
+        match status {
+            Some(status) if status.success() => return Ok(true),
+            Some(status) => return Err(format!("Claritide sync exited with status {status}")),
+            None => thread::sleep(Duration::from_millis(100)),
+        }
+    }
+}
