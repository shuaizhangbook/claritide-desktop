+fn replace_installation_id() -> Result<String, String> {
+    let machine = aw_server::device_id::get_device_id()
+        .chars()
+        .map(|character| {
+            if character.is_ascii_alphanumeric() || matches!(character, '-' | '_' | '.') {
+                character
+            } else {
+                '-'
+            }
+        })
+        .take(80)
+        .collect::<String>();
+    let installation_id = format!(
+        "desktop-{}-{}-{}",
+        machine,
+        now_unix_ms(),
+        std::process::id()
+    );
+    let serialized = serde_json::to_vec_pretty(&serde_json::json!({
+        "installation_id": installation_id.clone(),
+    }))
+    .map_err(|error| format!("Unable to encode desktop identity: {error}"))?;
+    write(desktop_identity_path(), serialized)
+        .map_err(|error| format!("Unable to save desktop identity: {error}"))?;
+    Ok(installation_id)
+}
