+fn write_sync_config_atomically(config: &DesktopSyncConfig) -> Result<(), String> {
+    validate_sync_config(config)?;
+    let path = sync_config_path();
+    let temporary = path.with_extension("json.tmp");
+    let backup = path.with_extension("json.bak");
+    let serialized = serde_json::to_vec_pretty(config)
+        .map_err(|error| format!("Unable to encode sync configuration: {error}"))?;
+    let mut temporary_file = OpenOptions::new()
+        .create(true)
+        .truncate(true)
+        .write(true)
+        .open(&temporary)
+        .map_err(|error| format!("Unable to open temporary sync configuration: {error}"))?;
+    temporary_file
+        .write_all(&serialized)
+        .and_then(|_| temporary_file.sync_all())
+        .map_err(|error| format!("Unable to save temporary sync configuration: {error}"))?;
+    drop(temporary_file);
+    if backup.exists() {
+        remove_file(&backup)
+            .map_err(|error| format!("Unable to remove an old sync backup: {error}"))?;
+    }
+    if path.exists() {
+        rename(&path, &backup)
+            .map_err(|error| format!("Unable to back up sync configuration: {error}"))?;
+    }
+    if let Err(error) = rename(&temporary, &path) {
+        if backup.exists() {
+            let _ = rename(&backup, &path);
+        }
+        return Err(format!("Unable to activate sync configuration: {error}"));
+    }
+    if backup.exists() {
+        remove_file(backup)
+            .map_err(|error| format!("Unable to remove sync configuration backup: {error}"))?;
