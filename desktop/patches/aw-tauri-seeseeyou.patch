+#[tauri::command]
+fn configure_sync(config: DesktopSyncConfig) -> Result<(), String> {
+    let _control = SYNC_CONTROL
+        .get_or_init(|| Mutex::new(()))
+        .lock()
+        .map_err(|_| "Sync control is unavailable".to_string())?;
+    validate_sync_config(&config)?;
+    let had_existing_config = sync_config_path().exists();
+    let previous = load_validated_sync_config().ok().flatten();
+    write(sync_paused_path(), b"paused")
+        .map_err(|error| format!("Unable to pause the previous sync: {error}"))?;
+    cancel_active_sync()?;
+    let identity_changed = previous.as_ref().map_or(had_existing_config, |old| {
+        old.device_id != config.device_id
+            || old.employee_id != config.employee_id
+            || old.team_id != config.team_id
+    });
+    let new_identity = previous.is_none();
+    let rebind_pending = sync_rebind_pending_path().exists();
+    if identity_changed || new_identity || rebind_pending {
+        remove_sync_state()?;
+        seed_fresh_sync_cursor()?;
+    }
+    write_sync_config_atomically(&config)?;
+    if rebind_pending {
+        remove_file(sync_rebind_pending_path())
+            .map_err(|error| format!("Unable to finish sync identity change: {error}"))?;
+    }
+    let paused = sync_paused_path();
+    if paused.exists() {
+        remove_file(paused).map_err(|error| format!("Unable to enable sync: {error}"))?;
+    }
+    update_sync_runtime(|state| *state = SyncRuntimeState::default());
+    trigger_sync()
+}
+
+#[tauri::command]
+fn pause_sync() -> Result<(), String> {
+    let _control = SYNC_CONTROL
+        .get_or_init(|| Mutex::new(()))
+        .lock()
+        .map_err(|_| "Sync control is unavailable".to_string())?;
+    write(sync_paused_path(), b"paused")
+        .map_err(|error| format!("Unable to pause sync: {error}"))?;
+    cancel_active_sync()?;
+    update_sync_runtime(|state| {
+        state.running = false;
+        state.last_error = None;
+    });
+    Ok(())
+}
+
+#[tauri::command]
+fn resume_sync(employee_id: String, team_id: String) -> Result<(), String> {
+    let _control = SYNC_CONTROL
+        .get_or_init(|| Mutex::new(()))
+        .lock()
+        .map_err(|_| "Sync control is unavailable".to_string())?;
+    if employee_id.trim().is_empty() || team_id.trim().is_empty() {
+        return Err("Employee and team identity are required to resume sync".to_string());
+    }
+    if sync_rebind_pending_path().exists() {
+        return Err("This computer must be re-enrolled before sync can resume".to_string());
+    }
+    let mut config = load_validated_sync_config()?
+        .ok_or_else(|| "Claritide sync is not configured".to_string())?;
+    if config.employee_id != employee_id
+        || config
+            .team_id
+            .as_deref()
+            .is_some_and(|saved_team| saved_team != team_id.as_str())
+    {
+        return Err("The saved sync identity does not match this account and team".to_string());
+    }
+    let paused = sync_paused_path();
+    if config.team_id.is_none() && !paused.exists() {
+        return Err("Pause sync before assigning a legacy configuration to a team".to_string());
+    }
+    if config.team_id.is_none() {
+        config.team_id = Some(team_id);
+        write_sync_config_atomically(&config)?;
+    }
+    if !paused.exists() {
+        // A running worker must remain reflected in SYNC_RUNTIME so clear/configure
+        // can cancel it before touching its files. The scheduler serializes this
+        // extra trigger behind the current child.
+        return trigger_sync();
+    }
+    remove_file(paused).map_err(|error| format!("Unable to resume sync: {error}"))?;
+    update_sync_runtime(|state| *state = SyncRuntimeState::default());
+    trigger_sync()
+}
+
+#[tauri::command]
+fn trigger_sync_now() -> Result<(), String> {
+    let _control = SYNC_CONTROL
+        .get_or_init(|| Mutex::new(()))
+        .lock()
+        .map_err(|_| "Sync control is unavailable".to_string())?;
+    if sync_paused_path().exists() {
+        return Err("Claritide sync is paused".to_string());
+    }
+    if sync_rebind_pending_path().exists() {
+        return Err("This computer must be re-enrolled before sync can run".to_string());
+    }
+    if load_validated_sync_config()?.is_none() {
+        return Err("Claritide sync is not configured".to_string());
+    }
+    trigger_sync()
+}
+
+#[tauri::command]
+fn clear_sync() -> Result<(), String> {
+    let _control = SYNC_CONTROL
+        .get_or_init(|| Mutex::new(()))
+        .lock()
+        .map_err(|_| "Sync control is unavailable".to_string())?;
+    write(sync_paused_path(), b"paused")
+        .map_err(|error| format!("Unable to stop sync: {error}"))?;
+    cancel_active_sync()?;
+    write(sync_rebind_pending_path(), b"re-enroll")
+        .map_err(|error| format!("Unable to mark sync identity for re-enrollment: {error}"))?;
+    let path = sync_config_path();
+    if path.exists() {
+        remove_file(path)
+            .map_err(|error| format!("Unable to clear sync configuration: {error}"))?;
+    }
+    remove_sync_state()?;
+    update_sync_runtime(|state| *state = SyncRuntimeState::default());
+    Ok(())
+}
